# Copy this file to .env and fill in your key. server/index.js reads it via
# process.env — start the server with `node --env-file=.env server/index.js`
# (Node 20+) or use `dotenv`/`concurrently` with your own env loader.

# NVIDIA NIM API (Free tier available!)
# Get your free API key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-YOUR_API_KEY_HERE
NVIDIA_MODEL=minimaxai/minimax-m3

PORT=8787
